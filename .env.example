# Copy to .env.local for local setup; keep real values out of git and browser code.
# Leave unset to review the form's honest unavailable state without sending email.
# Create a server API key in Resend and verify your sending domain before setup.
RESEND_API_KEY=
# One plain email address on your verified domain, e.g. contact@your-domain.example.
CONTACT_FROM_EMAIL=
# Required in production: exact public origin, no path, e.g. https://your-domain.example.
# Local development/test can fall back to the request URL origin.
CONTACT_ORIGIN=
# The inbox is fixed in src/content/profile.ts; visitor email is Reply-To only.
# Run with a Next.js server (pnpm build then pnpm preview/start), not static hosting.
# Basic per-process limits: 3 attempts/email and 60 total attempts per 10 minutes.
# Memory is bounded to 60 expiring email records; failed provider attempts also count.
# Restarts/multiple instances reset/split these limits. Add shared/edge host limits
# before public hosting. Do not rely on these as a distributed anti-spam quota.
