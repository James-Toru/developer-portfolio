{
  "name": "midnight-network-portfolio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": { "node": ">=24.15.0 <25" },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:verify": "pnpm run build && node scripts/prepare-verification-output.mjs",
    "start": "next start",
    "test": "vitest run && node --test scripts/verification.test.mjs",
    "test:content": "vitest run src/lib/projects.test.ts",
    "test:static": "vitest run src/lib/static-output.test.ts",
    "test:watch": "vitest",
    "check:static": "node scripts/check-static-output.mjs",
    "measure:assets": "node scripts/measure-assets.mjs",
    "preview": "next start --hostname 127.0.0.1 --port 4173",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "30.1.3",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
